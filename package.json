{
  "name": "my-app",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "test": "bun test tests",
    "preview": "vike build && vike preview",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply MY_VIKE_DEMO_DATABASE --local",
    "db:migrate:remote": "wrangler d1 migrations apply MY_VIKE_DEMO_DATABASE --remote",
    "db:seed:local": "wrangler d1 execute MY_VIKE_DEMO_DATABASE --local --file=./scripts/seed.sql --yes",
    "db:seed:remote": "wrangler d1 execute MY_VIKE_DEMO_DATABASE --remote --file=./scripts/seed.sql --yes",
    "deploy": "vike build && wrangler deploy",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@lucide/vue": "^1.28.0",
    "@tanstack/vue-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "@universal-middleware/core": "^0.4.18",
    "@unovis/vue": "^1.6.7",
    "@vikejs/hono": "^0.2.1",
    "@vueuse/core": "^14.4.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "telefunc": "^0.2.22",
    "vike": "0.4.260",
    "vike-vue": "^0.9.13",
    "vue": "^3.5.40",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.37",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
